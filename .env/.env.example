# --- 데이터베이스 연결 정보 ---

synchronize= # Production 환경에서는 false로 설정 

# DB 종류 (TypeORM 설정에 사용)
DB_TYPE= 

# DB 호스트 주소
DB_HOST=

# DB 포트 번호
DB_PORT=

# DB 사용자 이름
DB_USERNAME= # 데이터베이스 관리 툴에서 사용하는 실제 사용자 ID (예: postgres)

# DB 비밀번호
DB_PASSWORD= # 해당 사용자 ID의 실제 비밀번호

# 연결할 데이터베이스 이름
DB_DATABASE= # TypeORM이 데이터를 저장할 데이터베이스 이름

# -- CORS 세팅 ---

CORS_ORIGIN= # 배열 형태로 콤마(,)로 구분하여 여러 도메인 추가 가능 (예: http://localhost:3000,http://localhost:3080)

CORS_METHODS= # 배열 형태로 콤마(,)로 구분하여 여러 메서드 추가 가능 (예: GET,HEAD,PUT,PATCH,POST,DELETE)